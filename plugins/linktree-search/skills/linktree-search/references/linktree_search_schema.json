{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LINKTREE Search Skill Input",
  "type": "object",
  "required": [
    "rootUrl"
  ],
  "properties": {
    "rootUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "default": 4
    },
    "maxPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000,
      "default": 250
    },
    "sameOriginOnly": {
      "type": "boolean",
      "default": true
    },
    "allowSubdomains": {
      "type": "boolean",
      "default": false
    },
    "respectRobots": {
      "type": "boolean",
      "default": true
    },
    "preferSitemaps": {
      "type": "boolean",
      "default": true
    },
    "includeNofollow": {
      "type": "boolean",
      "default": false
    },
    "stripTrackingParams": {
      "type": "boolean",
      "default": true
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 60000,
      "default": 12000
    },
    "maxResponseBytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 10485760,
      "default": 2097152
    }
  },
  "additionalProperties": false
}